# Pin image tags here and replace with immutable digests before production rollout (FR-HST-04).
[Unit]
Description=Fleet agent sandbox %i

[Container]
ContainerName=fleet-agent-%i
Image=ghcr.io/example/fleet-sandbox:0.1.0
ReadOnly=true
NoNewPrivileges=true
UserNS=keep-id
PodmanArgs=--security-opt=no-new-privileges --security-opt=seccomp=/usr/share/containers/seccomp.json --cap-drop=all --network=none
Volume=/var/lib/fleet/agents/%i:/home/fleet/.copilot:Z
WorkingDir=/workspace

[Service]
Restart=on-failure
RestartSec=5s
