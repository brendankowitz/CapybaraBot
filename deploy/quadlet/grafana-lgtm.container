# Pin image tags here and replace with immutable digests before production rollout (FR-HST-04).
[Unit]
Description=Grafana LGTM stack (loopback only)

[Container]
Image=docker.io/grafana/otel-lgtm:0.11.10
PublishPort=127.0.0.1:3000:3000
PublishPort=127.0.0.1:4317:4317
PublishPort=127.0.0.1:4318:4318
Volume=/var/lib/capybara/grafana-lgtm:/data:Z

[Service]
Restart=on-failure
