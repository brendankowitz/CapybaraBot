# Pin image tags here and replace with immutable digests before production rollout (FR-HST-04).
[Unit]
Description=Aspire dashboard (loopback only)

[Container]
Image=mcr.microsoft.com/dotnet/aspire-dashboard:9.0
PublishPort=127.0.0.1:18888:18888
Environment=DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS=true

[Service]
Restart=on-failure
