# capybarad: hardened systemd unit (FR-HST-02).
# MemoryDenyWriteExecute is intentionally NOT set: the .NET JIT and the Copilot CLI's Node runtime need W^X pages.
[Unit]
Description=Capybara agent fleet gateway (capybarad)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
User=capybara
Group=capybara
ExecStart=/opt/capybara/capybarad
WorkingDirectory=/opt/capybara
Environment=DOTNET_ENVIRONMENT=Production
Environment=Capybara__ConfigRoot=/etc/capybara
Environment=Capybara__StateRoot=/var/lib/capybara
Restart=on-failure
RestartSec=5s

# The Copilot PAT is an encrypted credential, never an env var or config file (FR-HST-03).
LoadCredentialEncrypted=github-token:/etc/capybara/credentials/github-token.cred

StateDirectory=capybara
StateDirectoryMode=0700
ConfigurationDirectory=capybara
ReadOnlyPaths=/etc/capybara
ReadWritePaths=/var/lib/capybara

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
