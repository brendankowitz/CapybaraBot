# fleet-broker: credential broker hardened like fleetd (FR-HST-02).
# MemoryDenyWriteExecute is intentionally NOT set because .NET and Node JITs require executable memory.
[Unit]
Description=CharcuterieBot credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=fleet-broker
Group=fleet-broker
ExecStart=/opt/fleet/fleet-broker
WorkingDirectory=/opt/fleet
Environment=DOTNET_ENVIRONMENT=Production
Restart=on-failure
RestartSec=5s
LoadCredentialEncrypted=github-token:/etc/fleet/credentials/github-token.cred
LoadCredentialEncrypted=broker-secrets:/etc/fleet/credentials/broker-secrets.cred
StateDirectory=fleet-broker
StateDirectoryMode=0700
ConfigurationDirectory=fleet
ReadOnlyPaths=/etc/fleet
ReadWritePaths=/var/lib/fleet-broker
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
