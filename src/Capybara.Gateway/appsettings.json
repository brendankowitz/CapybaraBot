{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Capybara": {
    "ConfigRoot": "/etc/capybara",
    "StateRoot": "/var/lib/capybara",
    "GitHubTokenCredential": "github-token",
    "Gateway": {
      "Port": 8787,
      "AllowedLogin": "",
      "AllowedOrigins": [],
      "Devices": []
    },
    "Runtime": {
      "AutoStart": true,
      "CliPath": null
    },
    "Supervisor": {
      "CheckInterval": "00:00:30",
      "MaxCrashes": 5
    }
  }
}
