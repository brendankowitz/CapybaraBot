{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Capybara": {
    "ConfigRoot": "/etc/capybara",
    "StateRoot": "/var/lib/capybara",
    "GitHubTokenCredential": "github-token",
    "Gateway": {
      "Port": 8787,
      "AllowedLogin": "",
      "AllowedOrigins": [],
      "Devices": []
    },
    "Runtime": {
      "AutoStart": true,
      "CliPath": null,
      "SessionScopedGitHubToken": true,
      "EnvExecutable": "/usr/bin/env",
      "EnvExecutableSha256": null,
      "Sandbox": {
        "SrtPath": null,
        "CopilotCliPath": null,
        "SettingsDirectory": null
      }
    },
    "Supervisor": {
      "CheckInterval": "00:00:30",
      "MaxCrashes": 5
    },
    "Broker": {
      "BaseAddress": "http://127.0.0.1:8788",
      "UnixSocketPath": null,
      "ApiKeyCredential": "broker-api-key",
      "TokenExpiryLeadTime": "3.00:00:00"
    },
    "Channels": {
      "Ntfy": {
        "BaseUrl": null,
        "Topic": null,
        "AccessTokenCredential": null,
        "SupportsSensitiveContent": true,
        "GatewayBaseUrl": null
      },
      "Telegram": {
        "BotTokenCredential": "telegram-bot-token",
        "ChatId": null,
        "AllowedUserId": null
      },
      "WebPush": {
        "Subject": "mailto:capybara@localhost",
        "PublicKey": null,
        "PrivateKeyCredential": "webpush-vapid-private-key"
      },
      "QuietHours": {
        "Enabled": false,
        "StartsAt": "22:00",
        "EndsAt": "07:00"
      }
    },
    "Telemetry": {
      "OtlpEndpoint": null,
      "OtlpProtocol": "http/protobuf"
    },
    "Quota": {
      "PollInterval": "00:15:00"
    },
    "Backup": {
      "InProcess": true
    }
  }
}
