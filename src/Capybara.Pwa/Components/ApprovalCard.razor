@* Rich approval preview (FR-CLI-02, FR-SAF-04, FR-SAF-07). Every value comes from an agent and is bound as a text node:
   no MarkupString, no <img>, no <a>, so nothing remote can load or unfurl. Every string goes through ApprovalPreview.Reveal so
   bidi/zero-width/control characters show as ⟦U+XXXX⟧ tokens instead of reordering or hiding what is sent; recipients also show
   non-ASCII characters as code points. Nothing is hidden: link/image targets and non-displayed content are listed as text, and
   the exact arguments are always one click away. A card whose arguments were not seen in full, unambiguously and visibly can
   only be denied. *@
@{
    var preview = ApprovalPreview.Parse(Approval);
}
<article class="card approval @RiskClass">
    <h2>@R(Approval.Agent) · @R(Approval.Tool)</h2>
    <p>
        <span class="badge risk">Risk: @R(Approval.Risk)</span>
        <span class="muted">expires @Approval.ExpiresAt.ToLocalTime().ToString("t")</span>
    </p>
    @if (!string.IsNullOrEmpty(Approval.ReviewerVerdict))
    {
        <p class="reviewer">Reviewer: <b>@R(Approval.ReviewerVerdict)</b>@(string.IsNullOrEmpty(Approval.ReviewerRationale) ? string.Empty : " - " + R(Approval.ReviewerRationale))</p>
    }

    @if (preview.BlockReason is { } reason)
    {
        <p class="warning block-reason" role="alert">@reason You can only deny this request.</p>
    }
    @foreach (var warning in preview.Warnings)
    {
        <p class="warning notice">@warning</p>
    }

    @switch (preview.Kind)
    {
        case "email" when preview.Email is { } email:
            <section class="email-preview" aria-label="Email preview">
                <dl>
                    <dt>To</dt><dd class="recipient">@ApprovalPreview.RevealNonAscii(email.To)</dd>
                    @if (!string.IsNullOrEmpty(email.Cc)) { <dt>Cc</dt><dd class="recipient">@ApprovalPreview.RevealNonAscii(email.Cc)</dd> }
                    <dt>Subject</dt><dd>@R(email.Subject)</dd>
                </dl>
                <pre class="email-body">@R(email.BodyText)</pre>
                @if (email.References.Count > 0)
                {
                    <p class="muted">Links and images in the email (shown as text, never loaded):</p>
                    <ul class="email-references">@foreach (var reference in email.References) { <li><code>@ApprovalPreview.RevealNonAscii(reference)</code></li> }</ul>
                }
                @if (email.HiddenContent.Count > 0)
                {
                    <p class="warning hidden-content">Hidden content: this email contains text a mail client would not display.</p>
                    @foreach (var hidden in email.HiddenContent) { <pre class="hidden-content-text">@R(hidden)</pre> }
                }
                @if (email.RemoteImagesBlocked > 0 || email.LinksStripped > 0)
                {
                    <p class="muted">Not rendered: @email.RemoteImagesBlocked image(s), @email.LinksStripped link(s).</p>
                }
            </section>
            break;
        case "diff" when preview.Diff is not null:
            <DiffView Text="@preview.Diff" />
            break;
    }

    @if (preview.Args.Count > 0)
    {
        <table class="args">
            <thead><tr><th>Argument</th><th>Value</th></tr></thead>
            <tbody>
            @foreach (var arg in preview.Args)
            {
                var conflicting = preview.ConflictingKeys.Contains(arg.Key, StringComparer.Ordinal);
                <tr class="@(conflicting ? "conflict" : string.Empty)"><th scope="row">@ApprovalPreview.RevealNonAscii(arg.Key)@(conflicting ? " (conflicting name)" : string.Empty)</th><td><code>@R(arg.Value)</code></td></tr>
            }
            </tbody>
        </table>
    }

    <details open="@(!preview.CanApprove || (preview.Args.Count == 0 && preview.Kind == "args"))">
        <summary>Exact arguments as received</summary>
        <pre class="exact-args">@R(preview.Exact)</pre>
    </details>

    <div class="actions">
        <button type="button" disabled="@(!preview.CanApprove)" @onclick="() => OnDecide.InvokeAsync(ApprovalDecisions.AllowOnce)">Allow once</button>
        @if (Approval.OffersAlwaysAllow)
        {
            <button type="button" disabled="@(!preview.CanApprove)" @onclick="() => OnDecide.InvokeAsync(ApprovalDecisions.AlwaysAllow)">Always</button>
        }
        <button type="button" class="danger" @onclick="() => OnDecide.InvokeAsync(ApprovalDecisions.Deny)">Deny</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ApprovalDto Approval { get; set; } = default!;

    /// <summary>Raised with one of <see cref="ApprovalDecisions"/>.</summary>
    [Parameter] public EventCallback<string> OnDecide { get; set; }

    private string RiskClass => Approval.Risk.Equals("High", StringComparison.OrdinalIgnoreCase) ? "risk-high" : string.Empty;

    private static string R(string? text) => ApprovalPreview.Reveal(text);
}
