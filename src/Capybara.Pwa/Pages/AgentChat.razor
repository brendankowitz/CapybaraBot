@page "/agents/{Id}"
@inherits CapybaraPage
@inject CapybaraRealtimeService Realtime
@implements IDisposable

<h1>Chat: @Id</h1>
<ErrorBanner Message="@Error" />
<div class="chat" aria-live="polite">
@foreach (var line in _lines)
{
    <div class="chat-line @line.Kind">
        <span class="muted">@line.At.ToLocalTime().ToString("g")</span>
        <pre>@line.Text</pre>
    </div>
}
</div>
@if (_busy) { <p class="muted">Working…</p> }
<textarea @bind="_prompt" rows="5" placeholder="Message"></textarea>
<label><input type="checkbox" checked="@_incognito" @onchange="OnIncognitoChanged" /> Incognito (reads and writes no memory)</label>
<button type="button" disabled="@_busy" @onclick="SendAsync">Send</button>

<section>
    <h2>Model</h2>
    <input @bind="_model" placeholder="model id, e.g. auto" />
    <button type="button" disabled="@string.IsNullOrWhiteSpace(_model)" @onclick="SetModelAsync">Change model</button>
</section>

@code {
    private sealed record ChatLine(DateTimeOffset At, string Kind, string Text);

    private readonly List<ChatLine> _lines = [];
    private string _prompt = string.Empty;
    private string _model = string.Empty;
    private bool _incognito;
    private string? _conversationId;
    private bool _busy;

    [Parameter] public string Id { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Realtime.ThreadEntry += OnThreadEntry;
        var history = await TryAsync(() => Api.GetChatHistoryAsync(Id));
        foreach (var entry in history ?? [])
        {
            _lines.Add(new ChatLine(entry.At, entry.Role, entry.Content));
        }

        await Realtime.TryStartAsync();
    }

    private void OnIncognitoChanged(ChangeEventArgs args)
    {
        _incognito = args.Value is true;
        _conversationId = _incognito ? Guid.NewGuid().ToString("N") : null;
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            return;
        }

        var prompt = _prompt;
        _prompt = string.Empty;
        _lines.Add(new ChatLine(DateTimeOffset.Now, "user", prompt));
        ClearError();
        _busy = true;
        var result = await TryAsync(() => Api.SendTurnAsync(Id, new TurnRequestDto(prompt, _incognito, _conversationId)));
        _busy = false;
        if (result is not null)
        {
            _lines.Add(new ChatLine(DateTimeOffset.Now, "assistant", result.Content));
        }
    }

    private async Task SetModelAsync()
    {
        ClearError();
        await TryAsync(() => Api.SetModelAsync(Id, _model));
    }

    // Live fleet-thread traffic involving this agent, alongside the conversation.
    private void OnThreadEntry(ThreadEntryDto entry)
    {
        if (!string.Equals(entry.From, Id, StringComparison.OrdinalIgnoreCase) && !string.Equals(entry.To, Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _lines.Add(new ChatLine(entry.At, "thread", $"{entry.From} → {entry.To}: {entry.Summary}"));
            StateHasChanged();
        });
    }

    public void Dispose() => Realtime.ThreadEntry -= OnThreadEntry;
}
