@page "/memory"
@inherits CapybaraPage
@inject IJSRuntime Js

<h1>Memory</h1>
<ErrorBanner Message="@Error" />
<p class="muted">Memory content is untrusted: it is shown and edited as plain text only.</p>
<input @bind="_prefix" placeholder="Prefix, e.g. /agents/ea" />
<button type="button" @onclick="LoadPagesAsync">Browse</button>
<button type="button" @onclick="ExportAsync">Export zip</button>

<section>
    <h2>Pending changes</h2>
    @if (_pending.Count == 0)
    {
        <p class="muted">None.</p>
    }
    @foreach (var change in _pending)
    {
        <article class="card" @key="change.Id">
            <b>@change.Kind</b> @change.Path <span class="muted">by @change.ProposedBy@(change.Reason is null ? string.Empty : " · " + change.Reason)</span>
            @if (change.Before is not null) { <h3>Before</h3><pre>@change.Before</pre> }
            <h3>After</h3><pre>@change.After</pre>
            <button type="button" @onclick="() => ResolveAsync(change, apply: true)">Apply</button>
            <button type="button" class="danger" @onclick="() => ResolveAsync(change, apply: false)">Discard</button>
        </article>
    }
</section>

<div class="split">
    <ul>
        @foreach (var p in _pages)
        {
            <li><button type="button" @onclick="() => OpenAsync(p.Path)">@p.Path</button></li>
        }
    </ul>
    <section>
        <input @bind="_path" placeholder="Path" />
        <textarea @bind="_content" rows="16"></textarea>
        <button type="button" disabled="@string.IsNullOrWhiteSpace(_path)" @onclick="SaveAsync">Save</button>
        <button type="button" class="danger" disabled="@string.IsNullOrWhiteSpace(_path)" @onclick="DeleteAsync">Delete</button>
    </section>
</div>

@code {
    private string _prefix = string.Empty;
    private string _path = string.Empty;
    private string _content = string.Empty;
    private IReadOnlyList<MemoryPageInfoDto> _pages = [];
    private IReadOnlyList<PendingMemoryChangeDto> _pending = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPagesAsync();
        await LoadPendingAsync();
    }

    private async Task LoadPagesAsync() => _pages = await TryAsync(() => Api.GetMemoryPagesAsync(_prefix)) ?? _pages;

    private async Task LoadPendingAsync() => _pending = await TryAsync(() => Api.GetPendingMemoryAsync()) ?? _pending;

    private async Task OpenAsync(string path)
    {
        ClearError();
        if (await TryAsync(() => Api.GetMemoryPageAsync(path)) is { } page)
        {
            _path = page.Path;
            _content = page.Content;
        }
    }

    private async Task SaveAsync()
    {
        ClearError();
        await TryAsync(() => Api.SaveMemoryPageAsync(_path, _content));
        await LoadPagesAsync();
    }

    private async Task DeleteAsync()
    {
        ClearError();
        if (await TryAsync(() => Api.DeleteMemoryPageAsync(_path)))
        {
            _content = string.Empty;
        }

        await LoadPagesAsync();
    }

    private async Task ResolveAsync(PendingMemoryChangeDto change, bool apply)
    {
        ClearError();
        await TryAsync(() => Api.DecidePendingMemoryAsync(change.Id, apply));
        await LoadPendingAsync();
        await LoadPagesAsync();
    }

    private async Task ExportAsync()
    {
        ClearError();
        await TryAsync(async () =>
        {
            await using var stream = await Api.ExportMemoryAsync();
            using var reference = new DotNetStreamReference(stream);
            await Js.InvokeVoidAsync("capybaraDownload.fromStream", "capybara-memory.zip", reference);
        });
    }
}
